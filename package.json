{
  "name": "comarketing",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted social media planning, approval and scheduling for company marketing teams.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx scripts/worker.mts",
    "tick": "tsx scripts/worker.mts --once",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:prod": "prisma migrate deploy && sh -c 'if [ \"$SEED_DEMO\" = \"true\" ]; then tsx prisma/seed.ts; fi' && next start"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
