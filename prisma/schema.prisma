generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  creator
  approver
}

enum UserStatus {
  active
  disabled
}

enum Platform {
  instagram
  x
  facebook
  linkedin
}

enum ConnectionStatus {
  not_connected
  connected
  expired
  error
}

enum PostStatus {
  draft
  pending_approval
  approved
  rejected
  scheduled
  published
  failed
}

enum PostSource {
  manual
  ai
  auto
}

enum ApprovalActionType {
  submit
  approve
  reject
  request_changes
  comment
  schedule
  unschedule
}

model Company {
  id                    String     @id @default(cuid())
  name                  String
  industry              String     @default("")
  brandVoice            String     @default("")
  targetAudience        String     @default("")
  campaignGoals         String     @default("")
  prohibitedWords       String     @default("")
  hashtags              String     @default("")
  timezone              String     @default("UTC")
  postingCadence        Int        @default(1)
  preferredPublishTimes String[]   @default(["09:00"])
  defaultPlatforms      Platform[] @default([linkedin])
  autoGenerateEnabled   Boolean    @default(false)
  autoSubmitForApproval Boolean    @default(true)
  lastAutoGenerateDate  String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  users         User[]
  channels      ChannelConnection[]
  posts         Post[]
  aiGenerations AiGeneration[]
  activity      ActivityLog[]
  notifications Notification[]
}

model User {
  id           String     @id @default(cuid())
  companyId    String
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  status       UserStatus @default(active)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions        Session[]
  createdPosts    Post[]           @relation("PostCreatedBy")
  approvedPosts   Post[]           @relation("PostApprovedBy")
  approvalActions ApprovalAction[]
  notifications   Notification[]

  @@index([companyId])
}

model Session {
  id        String   @id // sha256 of the cookie token; the raw token is never stored
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChannelConnection {
  id               String           @id @default(cuid())
  companyId        String
  platform         Platform
  accountName      String           @default("")
  connectionStatus ConnectionStatus @default(not_connected)
  scopes           String[]         @default([])
  simulated        Boolean          @default(false)
  lastSyncAt       DateTime?
  lastError        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, platform])
}

model Post {
  id              String     @id @default(cuid())
  companyId       String
  title           String
  masterCopy      String     @default("")
  status          PostStatus @default(draft)
  source          PostSource @default(manual)
  scheduledAt     DateTime?
  suggestedAt     DateTime?
  createdById     String
  approvedById    String?
  version         Int        @default(1)
  publishLockedAt DateTime?
  publishedAt     DateTime?
  publishedVia    String? // "live" | "simulated"
  failureReason   String?
  publishAttempts Int        @default(0)
  lastAttemptAt   DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("PostCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?            @relation("PostApprovedBy", fields: [approvedById], references: [id])
  variants        PostVariant[]
  approvalActions ApprovalAction[]
  revisions       PostRevision[]
  aiGenerations   AiGeneration[]

  @@index([companyId, status])
  @@index([companyId, scheduledAt])
  @@index([status, scheduledAt])
}

model PostVariant {
  id            String    @id @default(cuid())
  postId        String
  platform      Platform
  copy          String    @default("")
  mediaUrl      String?
  previewData   Json?
  publishStatus String? // "published" | "failed" — set by the publishing job
  publishError  String?
  externalId    String?
  publishedAt   DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
}

model PostRevision {
  id         String   @id @default(cuid())
  postId     String
  version    Int
  title      String
  masterCopy String
  variants   Json
  editorId   String?
  createdAt  DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, version])
}

model ApprovalAction {
  id          String             @id @default(cuid())
  postId      String
  actorUserId String
  action      ApprovalActionType
  comment     String?
  createdAt   DateTime           @default(now())

  post  Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorUserId], references: [id])

  @@index([postId])
}

model AiGeneration {
  id          String   @id @default(cuid())
  companyId   String
  postId      String?
  createdById String?
  prompt      String
  modelRef    String
  outputText  String   @default("")
  succeeded   Boolean
  error       String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  post    Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  companyId   String
  actorUserId String? // null = system job
  actorName   String
  entityType  String
  entityId    String
  action      String
  outcome     String // "success" | "failure"
  detail      String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  type      String
  message   String
  postId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
