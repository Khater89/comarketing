# PostgreSQL connection string (required)
DATABASE_URL="postgresql://comarketing:comarketing@localhost:5432/comarketing?schema=public"

# AI draft generation (OpenAI Responses API). Server-side only — never expose to the browser.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
# AI_MODE: "openai" (default) or "mock" (development only; output is labelled as simulated in the UI)
AI_MODE="openai"

# Publishing: "none" (default — no live provider adapters exist yet, so due posts are marked failed with a reason)
# or "simulate" (development only; posts are marked "published (simulated)" and channels can be simulated-connected)
PUBLISHER_MODE="none"

# Shared secret for POST /api/cron/tick (external schedulers). Generate with: openssl rand -hex 32
CRON_SECRET=""
